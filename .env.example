# Gabarit des variables d'environnement. Copier en `.env` et remplir.
# `.env` est git-ignore, ce fichier ne l'est pas : n'y mettre aucune valeur.
#
# Les memes quatre variables sont posees en secrets du repo
# (Settings > Secrets and variables > Actions) pour les workflows.
#
# Les ids de bases Notion et de calendriers Google vivent dans
# config/instance.json, versionne : ce ne sont pas des secrets.

# Token d'integration Notion (`secret_xxx` ou `ntn_xxx`).
# Utilise par tous les scripts.
NOTION_TOKEN=

# Client OAuth Google, type "Desktop app" obligatoire.
# Utilises par import-gmail, sync-tasks-calendar, sync-planning-aline, clean-docs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Genere une seule fois par `npx tsx scripts/google-auth.ts`, qui l'ecrit
# directement dans `.env`. Porte les scopes gmail.modify + calendar.events.
# Voir docs/scripts/google-auth.md.
GOOGLE_REFRESH_TOKEN=
